    combos {
        compatible = "zmk,combos";

        combo_lshift {
            timeout-ms = <50>;
            key-positions = <36 37>;   // S + D; double tap = caps_word
            bindings = <&td_lsft_caps>;
            layers = <BASE>;
        };

        combo_rshift {
            timeout-ms = <50>;
            key-positions = <42 43>;   // K + L; double tap = caps_word
            bindings = <&td_rsft_caps>;
            layers = <BASE>;
        };

        combo_caps_word {
            timeout-ms = <75>;
            require-prior-idle-ms = <125>;
            key-positions = <36 37 42 43>;   // S + D + K + L
            bindings = <&caps_word>;
            layers = <BASE>;
        };

        combo_dongle_bootloader {
            timeout-ms = <500>;
            key-positions = <34 45>;   // MAGIC: left pinky + right pinky (both half bootloaders)
            bindings = <&bootloader>;
            layers = <MAGIC>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        resize_combo {
            if-layers = <WIN_MOVE WIN_SWAP>;
            then-layer = <WIN_RESIZE>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // BASE 0

        base_layer {
            // ---------------------------------------------------------------------------------------------------------------------------------------
            // | ESC   |NONE |NONE |NONE | NONE |                                                                    | NONE |NONE |NONE | NONE | NONE |
            // | NONE  |NONE |NONE |NONE | NONE | NONE |                                                    | NONE | NONE |NONE |NONE | NONE | NONE |
            // | NONE  |  Q  |  W  |  E  |  R   |  T   |                                                    |  Y   |  U   |  I  |  O  |  P   | NONE |
            // | NONE  |  A  |  S  |  D  |  F   |  G   |                                                    |  H   |  J   |  K  |  L  |  ;   |  '   |
            // | NONE  |  Z  |  X  |  C  |  V   |  B   |WIN/NROW|MSE/TOG| NONE  |MO(MSE)| NONE  |UNI/NPAD|  N   |  M   |  ,  |  .  |  /   | NONE |
            // | MAGIC |LCTL |LALT |LGUI |LSHFT |       | MO(SYM)| MO(NAV)|NPAD/NW| NONE  | ENT   | SYM/SPC|      | RSHFT| RGUI| RALT| RCTL | NONE |
            //
            // WIN/NROW: hold = WIN, tap = NUMROW num_word.  NPAD/NW: hold = NUMPAD, tap = NUMPAD num_word.
            // UNI/NPAD: tap = one-shot UNI, double tap = NUMPAD num_word.

            bindings = <
&kp ESC         &none      &none     &none     &none                                                                                                                &none      &none      &none     &none      &none
&none           &none      &none     &none     &none      &none                                                                                              &none  &none      &none      &none     &none      &none
&none           &kp Q      &kp W     &kp E     &kp R      &kp T                                                                                              &kp Y  &kp U      &kp I      &kp O     &kp P      &none
&caps_word      &kp A      &kp S     &kp D     &kp F      &kp G                                                                                              &kp H  &kp J      &kp K      &kp L     &kp SEMI   &kp SQT
&none           &kp Z      &kp X     &kp C     &kp V      &kp B  &lnr WIN NUMROW  &lht MOUSE MOUSE  &none               &mo MOUSE  &none      &td_uni_pad    &kp N  &kp M      &kp COMMA  &kp DOT   &kp FSLH   &none
&magic MAGIC 0  &kp LCTRL  &kp LALT  &kp LGUI  &kp LSHFT         &mo SYM          &mo NAV           &lnp NUMPAD NUMPAD  &none      &kp ENTER  &lt SYM SPACE         &kp RSHFT  &kp RGUI   &kp RALT  &kp RCTRL  &none
            >;
        };

        // NUMPAD 1

        numpad_layer {
            // NUMPAD: 10-key grid shifted up one row, 0 on upper-inner right thumb.
            // 7 8 9 on the number-row keys, 4 5 6 on U I O, 1 2 3 on J K L, minus on P, slash on ;.
            // &trans fill is deliberate: num_word only ends on real keycodes, so non-grid keys must
            // fall through. Period/comma fall through to their own keys; Space, Enter, or any letter
            // ends the mode. Entered from L_T6 (hold/tap) or double-tap on R_T1.

            bindings = <
&trans  &trans  &trans  &trans  &trans                                                                  &trans  &trans  &trans  &trans     &trans
&trans  &trans  &trans  &trans  &trans  &trans                                                  &trans  &kp N7  &kp N8  &kp N9  &trans     &trans
&trans  &trans  &trans  &trans  &trans  &trans                                                  &trans  &kp N4  &kp N5  &kp N6  &kp MINUS  &trans
&trans  &trans  &trans  &trans  &trans  &trans                                                  &trans  &kp N1  &kp N2  &kp N3  &kp FSLH   &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp N0  &trans  &trans  &trans  &trans  &trans     &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans  &trans     &trans
            >;
        };

        // NUMROW 2

        numrow_layer {
            // NUMROW: number-row digits one row down (Q..P = 1..0, minus right of P), same finger per digit.
            // The BASE number row is disabled; this layer and NUMPAD are the only digit sources.
            // Bottom-row mods on both hands fall through and do not end number mode (ignore-modifiers).
            // Entered by tapping WIN (num_word); ends on the first non-digit key.
            // Left home row = mods, so shift+digit (or SYM) gives the symbols.
            // &trans fill is deliberate (see NUMPAD).

            bindings = <
&trans  &trans     &trans    &trans    &trans                                                                     &trans  &trans  &trans  &trans  &trans
&trans  &trans     &trans    &trans    &trans     &trans                                                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp N1     &kp N2    &kp N3    &kp N4     &kp N5                                                  &kp N6  &kp N7  &kp N8  &kp N9  &kp N0  &kp MINUS
&trans  &kp LCTRL  &kp LALT  &kp LGUI  &kp LSHFT  &trans                                                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans     &trans    &trans    &trans     &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans     &trans    &trans    &trans             &trans  &trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans
            >;
        };

        // MAGIC 3

        magic_layer {
            bindings = <
&bt BT_CLR   &none            &none            &none            &none                                                                                          &none     &none  &none  &none      &bt BT_CLR_ALL
&none        &none            &none            &none            &none            &none                                                                  &none  &none     &none  &none  &none      &none
&none        &rgb_ug RGB_SPI  &rgb_ug RGB_SAI  &rgb_ug RGB_HUI  &rgb_ug RGB_BRI  &rgb_ug RGB_TOG                                                        &none  &none     &none  &none  &none      &none
&bootloader  &rgb_ug RGB_SPD  &rgb_ug RGB_SAD  &rgb_ug RGB_HUD  &rgb_ug RGB_BRD  &rgb_ug RGB_EFF                                                        &none  &none     &none  &none  &none      &bootloader
&sys_reset   &none            &none            &none            &none            &none            &bt_2  &bt_3  &none         &none  &none       &none  &none  &none     &none  &none  &none      &sys_reset
&none        &none            &none            &none            &none                             &bt_0  &bt_1  &out OUT_USB  &none  &info_dump  &none         &to GAME  &none  &none  &to STOCK  &to TEST
            >;
        };

        // TEST 4

        factory_test_layer {
            bindings = <
&kp N0  &kp N6  &kp N2  &kp N8  &kp N4                                                                  &kp N4  &kp N8  &kp N2  &kp N6  &kp N0
&kp N1  &kp N7  &kp N3  &kp N9  &kp N5  &kp N0                                                  &kp N0  &kp N5  &kp N9  &kp N3  &kp N7  &kp N1
&kp N2  &kp N8  &kp N4  &kp N0  &kp N6  &kp N1                                                  &kp N1  &kp N6  &kp N0  &kp N4  &kp N8  &kp N2
&kp N3  &kp N9  &kp N5  &kp N1  &kp N7  &kp N2                                                  &kp N2  &kp N7  &kp N1  &kp N5  &kp N9  &kp N3
&kp N4  &kp N0  &kp N6  &kp N2  &kp N8  &kp N3  &kp N4  &kp N5  &kp N6  &kp N6  &kp N5  &kp N4  &kp N3  &kp N8  &kp N2  &kp N6  &kp N0  &kp N4
&kp N5  &kp N1  &kp N7  &kp N3  &kp N9          &kp N7  &kp N8  &kp N9  &kp N9  &kp N8  &kp N7          &kp N9  &kp N3  &kp N7  &kp N1  &kp N5
            >;
        };

        // NAV 5

        nav_layer {
            // NAV: HJKL arrows, home row mods on left, nav cluster on right bottom alpha

            bindings = <
&none   &none      &none     &none     &none                                                                          &none        &none        &none        &none        &none
&none   &none      &none     &none     &none      &none                                                     &none     &none        &none        &none        &none        &none
&none   &none      &none     &none     &none      &none                                                     &none     &kp HS_PTAB  &none        &kp HS_NTAB  &none        &none
&none   &kp LCTRL  &kp LALT  &kp LGUI  &kp LSHFT  &none                                                     &kp LEFT  &kp DOWN     &kp UP       &kp RIGHT    &none        &none
&none   &none      &none     &none     &none      &none  &none  &none   &none  &none  &none          &none  &kp HOME  &kp PG_DN    &kp PG_UP    &kp END      &none        &none
&trans  &none      &none     &none     &none             &none  &trans  &none  &none  &kp LS(ENTER)  &none            &kp HS_SCDN  &kp HS_SCUP  &kp HS_BTN1  &kp HS_MCTR  &none
            >;
        };

        // SYM 6

        sym_layer {
            // SYM: symbols on left alpha, parens/brackets on right, mods on left home row

            bindings = <
&none   &none      &none     &none        &none                                                                                  &none     &none      &none     &none             &none
&none   &none      &none     &none        &none      &none                                                            &kp CARET  &kp AMPS  &kp ASTRK  &none     &none             &none
&none   &kp EXCL   &kp AT    &kp HASH     &kp DLLR   &kp PRCNT                                                        &kp ESC    &kp LBRC  &kp TAB    &kp RBRC  &kp SINGLE_QUOTE  &none
&none   &kp LCTRL  &kp LALT  &kp LGUI     &kp LSHFT  &kp EQUAL                                                        &kp PIPE   &kp LPAR  &kp MINUS  &kp RPAR  &kp COLON         &kp DQT
&none   &kp BSLH   &kp LT    &td_cpy_pst  &kp GT     &none      &none   &none  &none  &none  &kp DEL        &none     &kp GRAVE  &kp LBKT  &kp UNDER  &kp RBKT  &kp QMARK         &none
&trans  &trans     &trans    &trans       &trans                &trans  &none  &none  &none  &kp LG(ENTER)  &kp BSPC             &trans    &trans     &trans    &trans            &none
            >;
        };

        // UNI 7

        uni_layer {
            // UNI: app launchers via Hammerspoon, media, Magnet

            bindings = <
&none   &none      &none     &none        &none                                                                               &none        &none            &none        &none        &none
&none   &none      &none     &none        &none      &none                                                       &none        &none        &none            &none        &none        &none
&none   &none      &none     &kp HS_MENU  &none      &none                                                       &kp HS_CHRM  &kp HS_MEET  &lk_open_typora  &kp HS_SLAK  &kp HS_CODE  &kp HS_TERM
&none   &sk LCTRL  &sk LALT  &sk LGUI     &sk LSHFT  &none                                                       &td_rtm      &kp C_PREV   &kp C_PP         &kp C_NEXT   &kp HS_SPFY  &none
&none   &none      &none     &none        &none      &kp LC(B)  &kp HS_MENU  &none  &none  &none  &none  &trans  &none        &kp MAG_L    &kp MAG_MAX      &kp MAG_R    &kp MAG_RST  &none
&trans  &none      &none     &none        &none                 &none        &none  &none  &none  &none  &none                &none        &none            &none        &none        &none
            >;
        };

        // WIN 8

        win_layer {
            // WIN: Aerospace window management via AE_CHORD + verb dispatch

            bindings = <
&none  &none      &none      &none     &none                                                                                          &none         &none        &none         &none           &none
&none  &none      &none      &none     &none     &none                                                                 &none          &none         &none        &none         &none           &none
&none  &none      &ae_close  &none     &none     &none                                                                 &td_send       &ae_ws_prev   &ae_focus_u  &ae_ws_next   &ae_float_tile  &none
&none  &SK_PINKY  &SK_JOIN   &SK_SWAP  &SK_MOVE  &ae_balance                                                           &ae_focus_mon  &ae_focus_l   &ae_focus_d  &ae_focus_r   &ae_tiles_acc   &ae_back_forth
&none  &none      &none      &none     &none     &ae_reset    &none  &none  &none  &none  &none           &none        &none          &ae_dfs_prev  &none        &ae_dfs_next  &ae_horiz_vert  &none
&none  &none      &none      &none     &none                  &none  &none  &none  &none  &ae_fullscreen  &kp LEADERK                 &none         &none        &none         &none           &none
            >;
        };

        // GAME 9

        game_layer {
            // GAME: WASD game friendly layout

            bindings = <
&none      &none      &none   &none   &none                                                                               &kp F1  &kp F2     &kp F3    &kp F4    &kp F5
&kp GRAVE  &kp N6     &kp N7  &kp N8  &kp N9  &kp N0                                                              &kp F6  &kp F7  &kp F8     &kp F9    &kp F10   &kp MINUS
&kp T      &kp N1     &kp N2  &kp N3  &kp N4  &kp N5                                                              &kp Y   &kp U   &kp I      &kp O     &kp P     &none
&kp G      &kp TAB    &kp Q   &kp W   &kp E   &kp R                                                               &kp H   &kp J   &kp K      &kp L     &kp SEMI  &kp SQT
&kp B      &kp LSHFT  &kp A   &kp S   &kp D   &kp F   &none      &none      &none  &none     &kp UP    &none      &kp N   &kp M   &kp COMMA  &kp DOT   &kp FSLH  &none
&kp V      &kp LCTRL  &kp Z   &kp X   &kp C           &kp SPACE  &kp LCTRL  &none  &kp LEFT  &kp DOWN  &kp RIGHT          &none   &none      &kp LBKT  &kp RBKT  &to BASE
            >;
        };

        // WIN_MOVE 10

        win_move_layer {
            bindings = <
&none  &none   &none   &none   &none                                                           &none       &none       &none       &none  &none
&none  &none   &none   &none   &none   &none                                            &none  &none       &none       &none       &none  &none
&none  &none   &none   &none   &none   &none                                            &none  &none       &ae_move_u  &none       &none  &none
&none  &trans  &trans  &trans  &trans  &none                                            &none  &ae_move_l  &ae_move_d  &ae_move_r  &none  &none
&none  &none   &none   &none   &none   &none  &none  &none  &none  &none  &none  &none  &none  &none       &none       &none       &none  &none
&none  &none   &none   &none   &none          &none  &none  &none  &none  &none  &none         &none       &none       &none       &none  &none
            >;
        };

        // WIN_SWAP 11

        win_swap_layer {
            bindings = <
&none  &none   &none   &none   &none                                                           &none       &none       &none       &none  &none
&none  &none   &none   &none   &none   &none                                            &none  &none       &none       &none       &none  &none
&none  &none   &none   &none   &none   &none                                            &none  &none       &ae_swap_u  &none       &none  &none
&none  &trans  &trans  &trans  &trans  &none                                            &none  &ae_swap_l  &ae_swap_d  &ae_swap_r  &none  &none
&none  &none   &none   &none   &none   &none  &none  &none  &none  &none  &none  &none  &none  &none       &none       &none       &none  &none
&none  &none   &none   &none   &none          &none  &none  &none  &none  &none  &none         &none       &none       &none       &none  &none
            >;
        };

        // WIN_JOIN 12

        win_join_layer {
            bindings = <
&none  &none   &none   &none   &none                                                           &none       &none       &none       &none  &none
&none  &none   &none   &none   &none   &none                                            &none  &none       &none       &none       &none  &none
&none  &none   &none   &none   &none   &none                                            &none  &none       &ae_join_u  &none       &none  &none
&none  &trans  &trans  &trans  &trans  &none                                            &none  &ae_join_l  &ae_join_d  &ae_join_r  &none  &none
&none  &none   &none   &none   &none   &none  &none  &none  &none  &none  &none  &none  &none  &none       &none       &none       &none  &none
&none  &none   &none   &none   &none          &none  &none  &none  &none  &none  &none         &none       &none       &none       &none  &none
            >;
        };

        // WIN_RESIZE 13

        win_resize_layer {
            bindings = <
&none  &none   &none   &none   &none                                                           &none               &none               &none              &none  &none
&none  &none   &none   &none   &none   &none                                            &none  &none               &none               &none              &none  &none
&none  &none   &none   &none   &none   &none                                            &none  &none               &ae_resize_minus_h  &none              &none  &none
&none  &trans  &trans  &trans  &trans  &none                                            &none  &ae_resize_minus_w  &ae_resize_plus_h   &ae_resize_plus_w  &none  &none
&none  &none   &none   &none   &none   &none  &none  &none  &none  &none  &none  &none  &none  &none               &none               &none              &none  &none
&none  &none   &none   &none   &none          &none  &none  &none  &none  &none  &none         &none               &none               &none              &none  &none
            >;
        };

        // MOUSE 14

        mouse_layer {
            // hjkl = scroll, 8/uio = cursor move (inverted-T), xcv = right/mid/left click (left hand), SYM=trackball scroll mode, m/,/. = left/right/middle click, n=MB4 (back), /=MB5 (forward)

            bindings = <
&none  &none      &none     &none           &none                                                                                   &none           &none           &none            &none     &none
&none  &none      &none     &none           &none           &none                                                   &none           &none           &mmv MOVE_UP    &none            &none     &none
&none  &none      &none     &mo MOUSE_SLOW  &mo MOUSE_FAST  &none                                                   &none           &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &none     &none
&none  &kp LCTRL  &kp LALT  &kp LGUI        &kp LSHFT       &none                                                   &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP    &msc SCRL_RIGHT  &none     &none
&none  &none      &mkp MB2  &mkp MB3        &mkp MB1        &none  &none        &trans  &none  &none  &none  &none  &mkp MB4        &mkp MB1        &mkp MB3        &mkp MB2         &mkp MB5  &none
&none  &kp LCTRL  &kp LALT  &kp LGUI        &kp LSHFT              &kp HS_TSCR  &none   &none  &none  &none  &none                  &none           &none           &none            &none     &none
            >;
        };

        // MOUSE_SLOW 15

        mouse_slow_layer {
            // hold Q while scrolling/moving for precision speed
            bindings = <
&trans  &trans  &trans  &trans  &trans                                                                             &trans             &trans             &trans              &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                                                  &trans             &trans             &mmv MOVE_UP_LO    &trans              &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                                                  &trans             &mmv MOVE_LEFT_LO  &mmv MOVE_DOWN_LO  &mmv MOVE_RIGHT_LO  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                                                  &msc SCRL_LEFT_LO  &msc SCRL_DOWN_LO  &msc SCRL_UP_LO    &msc SCRL_RIGHT_LO  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans             &trans             &trans             &trans              &trans  &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans  &trans                     &trans             &trans             &trans              &trans  &trans
            >;
        };

        // MOUSE_FAST 16

        mouse_fast_layer {
            // hold R while scrolling/moving for turbo speed
            bindings = <
&trans  &trans  &trans  &trans  &trans                                                                             &trans             &trans             &trans              &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                                                  &trans             &trans             &mmv MOVE_UP_HI    &trans              &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                                                  &trans             &mmv MOVE_LEFT_HI  &mmv MOVE_DOWN_HI  &mmv MOVE_RIGHT_HI  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                                                  &msc SCRL_LEFT_HI  &msc SCRL_DOWN_HI  &msc SCRL_UP_HI    &msc SCRL_RIGHT_HI  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans             &trans             &trans             &trans              &trans  &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans  &trans                     &trans             &trans             &trans              &trans  &trans
            >;
        };

        // STOCK 17

        stock_layer {
            // STOCK: default Glove80 keycap layout for guest use; magic key exits back to BASE

            bindings = <
&kp F1     &kp F2    &kp F3   &kp F4    &kp F5                                                                                     &kp F6  &kp F7     &kp F8    &kp F9    &kp F10
&kp EQUAL  &kp N1    &kp N2   &kp N3    &kp N4     &kp N5                                                                  &kp N6  &kp N7  &kp N8     &kp N9    &kp N0    &kp MINUS
&kp TAB    &kp Q     &kp W    &kp E     &kp R      &kp T                                                                   &kp Y   &kp U   &kp I      &kp O     &kp P     &kp BSLH
&kp ESC    &kp A     &kp S    &kp D     &kp F      &kp G                                                                   &kp H   &kp J   &kp K      &kp L     &kp SEMI  &kp SQT
&kp GRAVE  &kp Z     &kp X    &kp C     &kp V      &kp B   &kp LSHFT  &kp LCTRL  &none     &kp LGUI  &kp RCTRL  &kp RSHFT  &kp N   &kp M   &kp COMMA  &kp DOT   &kp FSLH  &kp PG_UP
&to BASE   &kp HOME  &kp END  &kp LEFT  &kp RIGHT          &kp BSPC   &kp DEL    &kp LALT  &kp RALT  &kp RET    &kp SPACE          &kp UP  &kp DOWN   &kp LBKT  &kp RBKT  &kp PG_DN
            >;
        };
    };
};

&msc_input_listener { input-processors = <&zip_scroll_transform (INPUT_TRANSFORM_Y_INVERT | INPUT_TRANSFORM_X_INVERT)>; };

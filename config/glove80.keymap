#include <dt-bindings/zmk/mouse.h>
#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

#define HYPER(X) LC(LS(LG(LA(X))))

// Layers

#define BASE         0
#define NUMPAD       1
#define NUMROW       2
#define MAGIC        3
#define TEST         4
#define NAV          5
#define SYM          6
#define UNI          7
#define WIN          8
#define GAME         9
#define WIN_MOVE     10
#define WIN_SWAP     11
#define WIN_JOIN     12
#define WIN_RESIZE   13
#define MOUSE        14
#define MOUSE_SLOW   15
#define MOUSE_FAST   16
#define STOCK        17

// Hammerspoon Hyper-key triggers (HYPER is defined in glove80.keymap)

#define HS_WARP HYPER(A) // Launch warpd
#define HS_CHRM HYPER(B) // Launch Chrome
#define HS_MEET HYPER(C) // Launch Meet
#define HS_TYPR HYPER(D) // Launch Typora
#define HS_SLAK HYPER(E) // Launch Slack
#define HS_CODE HYPER(F) // Launch VS Code
#define HS_PTAB HYPER(G) // Previous Tab
#define HS_NTAB HYPER(H) // Next Tab
#define HS_SCRN HYPER(I) // Switch Monitor Focus
#define HS_TERM HYPER(J) // Launch iTerm2
#define HS_RTM  HYPER(K) // Launch Remember the Milk
#define HS_SPFY HYPER(L) // Launch Spotify
#define HS_SCDN HYPER(M) // Scroll Down
#define HS_SCUP HYPER(N) // Scroll Up
#define HS_BTN1 HYPER(O) // Click Mouse Button 1
#define HS_MCTR HYPER(P) // Move mouse to center of screen
#define HS_MENU HYPER(Q) // Open interactive hammerspoon menu system
#define HS_TSCR HYPER(R) // Trackball scroll mode
#define LEADERK HYPER(S) // Open Leader Key
#define HS_TNEW HYPER(T) // New Tab
#define SHRTCAT HYPER(U) // Shortcat.app
#define HRCLICK HYPER(V) // Homerow.app click mode
#define HRSCRLL HYPER(W) // Homerow.app scroll mode

// Magnet.app

#define MAG_L   LC(LA(LEFT))
#define MAG_R   LC(LA(RIGHT))
#define MAG_MAX LC(LA(ENTER))
#define MAG_RST LC(LA(BSPC))

// Aerospace.app — hyper chord triggers action mode; macros append the verb key

#define AE_CHORD HYPER(SPACE)

// Mouse speed overlay macros — hold E (slow) or R (fast) while scrolling/moving

#define SCRL_UP_LO    MOVE_Y(ZMK_POINTING_DEFAULT_SCRL_VAL / 3)
#define SCRL_DOWN_LO  MOVE_Y(-(ZMK_POINTING_DEFAULT_SCRL_VAL / 3))
#define SCRL_LEFT_LO  MOVE_X(-(ZMK_POINTING_DEFAULT_SCRL_VAL / 3))
#define SCRL_RIGHT_LO MOVE_X(ZMK_POINTING_DEFAULT_SCRL_VAL / 3)
#define SCRL_UP_HI    MOVE_Y(ZMK_POINTING_DEFAULT_SCRL_VAL * 3)
#define SCRL_DOWN_HI  MOVE_Y(-(ZMK_POINTING_DEFAULT_SCRL_VAL * 3))
#define SCRL_LEFT_HI  MOVE_X(-(ZMK_POINTING_DEFAULT_SCRL_VAL * 3))
#define SCRL_RIGHT_HI MOVE_X(ZMK_POINTING_DEFAULT_SCRL_VAL * 3)
#define MOVE_UP_LO    MOVE_Y(-(ZMK_POINTING_DEFAULT_MOVE_VAL / 3))
#define MOVE_DOWN_LO  MOVE_Y(ZMK_POINTING_DEFAULT_MOVE_VAL / 3)
#define MOVE_LEFT_LO  MOVE_X(-(ZMK_POINTING_DEFAULT_MOVE_VAL / 3))
#define MOVE_RIGHT_LO MOVE_X(ZMK_POINTING_DEFAULT_MOVE_VAL / 3)
#define MOVE_UP_HI    MOVE_Y(-(ZMK_POINTING_DEFAULT_MOVE_VAL * 3))
#define MOVE_DOWN_HI  MOVE_Y(ZMK_POINTING_DEFAULT_MOVE_VAL * 3)
#define MOVE_LEFT_HI  MOVE_X(-(ZMK_POINTING_DEFAULT_MOVE_VAL * 3))
#define MOVE_RIGHT_HI MOVE_X(ZMK_POINTING_DEFAULT_MOVE_VAL * 3)

// WIN layer LH home-row hold-taps: hold=sublayer, tap=sticky mod

#define SK_PINKY lsm 0 LCTRL
#define SK_JOIN  lsm WIN_JOIN LALT
#define SK_SWAP  lsm WIN_SWAP LGUI
#define SK_MOVE  lsm WIN_MOVE LSHFT

/ {
    behaviors {
        magic: magic_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&none>;
        };

        td_cpy_pst: tap_dance_copy_paste {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kpht LG(X) LG(C)>, <&kp LG(V)>;
        };

        kpht: key_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <500>;
            bindings = <&kp>, <&kp>;
        };

        td_rtm: tap_dance_rtm {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp HS_RTM>, <&kp LG(LA(M))>;
        };

        lht: layer_momentary_toggle {
            compatible = "zmk,behavior-hold-tap";
            label = "layer_momentary_toggle";
            bindings = <&mo>, <&tog>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        lsm: layer_or_sticky_key {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <100>;
            bindings = <&mo>, <&sk>;
        };

        info_dump: info_dump {
            compatible = "zmk,behavior-info-dump";
            #binding-cells = <0>;
        };

        td_send: tap_dance_send {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <250>;
            bindings =
                <&ae_send_mode>,
                <&ae_send_empty>,
                <&ae_send_empty_follow>;
        };

        // Auto-layers (urob/zmk-auto-layer): the layer stays active while typing
        // digits and the continue-list keys, and deactivates on any other keycode.
        // Tapping the trigger again also deactivates. Two instances so NUMROW and
        // NUMPAD keep independent on/off state.

        numrow_word: numrow_word {
            compatible = "zmk,behavior-auto-layer";
            #binding-cells = <1>;
            continue-list = <BSPC DEL DOT COMMA PLUS MINUS STAR FSLH EQUAL COLON>;
            ignore-numbers;
            ignore-modifiers; // home-row mods inside the layer must not end number mode
        };

        numpad_word: numpad_word {
            compatible = "zmk,behavior-auto-layer";
            #binding-cells = <1>;
            continue-list = <BSPC DEL DOT COMMA PLUS MINUS STAR FSLH EQUAL COLON>;
            ignore-numbers;
            ignore-modifiers;
        };

        // hold = momentary layer, tap = num_word. Balanced so a roll (thumb down, digit down,
        // thumb up, digit up) taps into num_word, while a key pressed and released under the
        // held thumb, or holding past the tapping term, resolves to the layer.

        lnr: layer_or_numrow_word {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&numrow_word>;
        };

        lnp: layer_or_numpad_word {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            bindings = <&mo>, <&numpad_word>;
        };

        // Shift combos (S+D, K+L): tap/hold = shift, double tap = caps_word.
        // Tap-dances resolve immediately on interrupt and stay held while the keys are
        // down, so single-tap and held shift behave as before.

        td_lsft_caps: tap_dance_lshift_caps_word {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LSHFT>, <&caps_word>;
        };

        td_rsft_caps: tap_dance_rshift_caps_word {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp RSHFT>, <&caps_word>;
        };

        // Right upper-inner thumb: tap = one-shot UNI, double tap = numpad num_word

        td_uni_pad: tap_dance_uni_numpad {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&sl UNI>, <&numpad_word NUMPAD>;
        };
    };

    macros {
        bt_0: bt_profile_macro_0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE &bt BT_SEL 0>;
        };

        bt_1: bt_profile_macro_1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE &bt BT_SEL 1>;
        };

        bt_2: bt_profile_macro_2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE &bt BT_SEL 2>;
        };

        bt_3: bt_profile_macro_3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE &bt BT_SEL 3>;
        };


#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>

#define HYPER(X) LC(LS(LG(LA(X))))

// Layers
#define BASE         0
#define NUM          1
#define MAGIC        2
#define TEST         3
#define NAV          4
#define SYM          5
#define UNI          6
#define WIN          7
#define GAME         8
#define WIN_MOVE     9
#define WIN_SWAP     10
#define WIN_JOIN     11
#define WIN_RESIZE   12

// Hammerspoon Hyper-key triggers (HYPER is defined in glove80.keymap)
#define HS_WARP HYPER(A) // Launch warpd
#define HS_CHRM HYPER(B) // Launch Chrome
#define HS_MEET HYPER(C) // Launch Meet
#define HS_TYPR HYPER(D) // Launch Typora
#define HS_SLAK HYPER(E) // Launch Slack
#define HS_CODE HYPER(F) // Launch VS Code
#define HS_PTAB HYPER(G) // Previous Tab
#define HS_NTAB HYPER(H) // Next Tab
#define HS_SCRN HYPER(I) // Switch Monitor Focus
#define HS_TERM HYPER(J) // Launch iTerm2
#define HS_RTM  HYPER(K) // Launch Remember the Milk
#define HS_SPFY HYPER(L) // Launch Spotify
#define HS_SCDN HYPER(M) // Scroll Down
#define HS_SCUP HYPER(N) // Scroll Up
#define HS_BTN1 HYPER(O) // Click Mouse Button 1
#define HS_MCTR HYPER(P) // Move mouse to center of screen
#define HS_MENU HYPER(Q) // Open interactive hammerspoon menu system
#define LEADERK HYPER(S) // Open Leader Key

// Magnet.app
#define MAG_L   LC(LA(LEFT))
#define MAG_R   LC(LA(RIGHT))
#define MAG_MAX LC(LA(ENTER))
#define MAG_RST LC(LA(BSPC))

// Aerospace.app — hyper chord triggers action mode; macros append the verb key
#define AE_CHORD HYPER(SPACE)

// WIN layer LH home-row hold-taps: hold=sublayer, tap=sticky mod
#define SK_PINKY lsm 0 LCTRL
#define SK_JOIN  lsm WIN_JOIN LALT
#define SK_SWAP  lsm WIN_SWAP LGUI
#define SK_MOVE  lsm WIN_MOVE LSHFT


/ {
    behaviors {
        magic: magic_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&rgb_ug_status_macro>;
        };

        td_cpy_pst: tap_dance_copy_paste {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kpht LG(X) LG(C)>, <&kp LG(V)>;
        };

        kpht: key_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <500>;
            bindings = <&kp>, <&kp>;
        };

        td_rtm: tap_dance_rtm {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp HS_RTM>, <&kp LG(LA(M))>;
        };

        lht: layer_momentary_toggle {
            compatible = "zmk,behavior-hold-tap";
            label = "layer_momentary_toggle";
            bindings = <&mo>, <&tog>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        lsm: layer_or_sticky_key {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <100>;
            bindings = <&mo>, <&sk>;
        };

        td_send: tap_dance_send {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <250>;
            bindings = <&ae_send_mode>, <&ae_send_empty>, <&ae_send_empty_follow>;
        };
    };

    macros {
        rgb_ug_status_macro: rgb_ug_status_macro_0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_STATUS>;
        };

        bt_0: bt_profile_macro_0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE &bt BT_SEL 0>;
        };

        bt_1: bt_profile_macro_1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE &bt BT_SEL 1>;
        };

        bt_2: bt_profile_macro_2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE &bt BT_SEL 2>;
        };

        bt_3: bt_profile_macro_3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE &bt BT_SEL 3>;
        };

        // Aerospace macros — each fires AE_CHORD then the verb key

        ae_focus_l: ae_focus_l {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <20>;
            tap-ms = <20>;
            bindings = <&kp AE_CHORD>, <&kp J>;
        };

        ae_focus_d: ae_focus_d {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <20>;
            tap-ms = <20>;
            bindings = <&kp AE_CHORD>, <&kp K>;
        };

        ae_focus_r: ae_focus_r {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <20>;
            tap-ms = <20>;
            bindings = <&kp AE_CHORD>, <&kp L>;
        };

        ae_focus_u: ae_focus_u {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <20>;
            tap-ms = <20>;
            bindings = <&kp AE_CHORD>, <&kp I>;
        };

        ae_move_l: ae_move_l {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <20>;
            tap-ms = <20>;
            bindings = <&kp AE_CHORD>, <&kp LS(J)>;
        };

        ae_move_d: ae_move_d {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <20>;
            tap-ms = <20>;
            bindings = <&kp AE_CHORD>, <&kp LS(K)>;
        };

        ae_move_r: ae_move_r {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <20>;
            tap-ms = <20>;
            bindings = <&kp AE_CHORD>, <&kp LS(L)>;
        };

        ae_move_u: ae_move_u {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <20>;
            tap-ms = <20>;
            bindings = <&kp AE_CHORD>, <&kp LS(I)>;
        };

        ae_swap_l: ae_swap_l {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <20>;
            tap-ms = <20>;
            bindings = <&kp AE_CHORD>, <&kp LG(J)>;
        };

        ae_swap_d: ae_swap_d {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <20>;
            tap-ms = <20>;
            bindings = <&kp AE_CHORD>, <&kp LG(K)>;
        };

        ae_swap_r: ae_swap_r {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <20>;
            tap-ms = <20>;
            bindings = <&kp AE_CHORD>, <&kp LG(L)>;
        };

        ae_swap_u: ae_swap_u {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <20>;
            tap-ms = <20>;
            bindings = <&kp AE_CHORD>, <&kp LG(I)>;
        };

        ae_join_l: ae_join_l {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <20>;
            tap-ms = <20>;
            bindings = <&kp AE_CHORD>, <&kp LA(J)>;
        };

        ae_join_d: ae_join_d {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <20>;
            tap-ms = <20>;
            bindings = <&kp AE_CHORD>, <&kp LA(K)>;
        };

        ae_join_r: ae_join_r {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <20>;
            tap-ms = <20>;
            bindings = <&kp AE_CHORD>, <&kp LA(L)>;
        };

        ae_join_u: ae_join_u {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <20>;
            tap-ms = <20>;
            bindings = <&kp AE_CHORD>, <&kp LA(I)>;
        };

        ae_resize_minus_w: ae_resize_minus_w {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <20>;
            tap-ms = <20>;
            bindings = <&kp AE_CHORD>, <&kp LG(LS(J))>;
        };

        ae_resize_plus_w: ae_resize_plus_w {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <20>;
            tap-ms = <20>;
            bindings = <&kp AE_CHORD>, <&kp LG(LS(L))>;
        };

        ae_resize_minus_h: ae_resize_minus_h {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <20>;
            tap-ms = <20>;
            bindings = <&kp AE_CHORD>, <&kp LG(LS(I))>;
        };

        ae_resize_plus_h: ae_resize_plus_h {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <20>;
            tap-ms = <20>;
            bindings = <&kp AE_CHORD>, <&kp LG(LS(K))>;
        };

        ae_close: ae_close {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <20>;
            tap-ms = <20>;
            bindings = <&kp AE_CHORD>, <&kp W>;
        };

        ae_ws_prev: ae_ws_prev {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <20>;
            tap-ms = <20>;
            bindings = <&kp AE_CHORD>, <&kp U>;
        };

        ae_ws_next: ae_ws_next {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <20>;
            tap-ms = <20>;
            bindings = <&kp AE_CHORD>, <&kp O>;
        };

        ae_float_tile: ae_float_tile {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <20>;
            tap-ms = <20>;
            bindings = <&kp AE_CHORD>, <&kp P>;
        };

        ae_tiles_acc: ae_tiles_acc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <20>;
            tap-ms = <20>;
            bindings = <&kp AE_CHORD>, <&kp SEMI>;
        };

        ae_horiz_vert: ae_horiz_vert {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <20>;
            tap-ms = <20>;
            bindings = <&kp AE_CHORD>, <&kp FSLH>;
        };

        ae_balance: ae_balance {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <20>;
            tap-ms = <20>;
            bindings = <&kp AE_CHORD>, <&kp G>;
        };

        ae_reset: ae_reset {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <20>;
            tap-ms = <20>;
            bindings = <&kp AE_CHORD>, <&kp B>;
        };

        ae_dfs_prev: ae_dfs_prev {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <20>;
            tap-ms = <20>;
            bindings = <&kp AE_CHORD>, <&kp M>;
        };

        ae_focus_mon: ae_focus_mon {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <20>;
            tap-ms = <20>;
            bindings = <&kp AE_CHORD>, <&kp H>;
        };

        ae_dfs_next: ae_dfs_next {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <20>;
            tap-ms = <20>;
            bindings = <&kp AE_CHORD>, <&kp DOT>;
        };

        ae_back_forth: ae_back_forth {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <20>;
            tap-ms = <20>;
            bindings = <&kp AE_CHORD>, <&kp SQT>;
        };

        ae_fullscreen: ae_fullscreen {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <20>;
            tap-ms = <20>;
            bindings = <&kp AE_CHORD>, <&kp F>;
        };

        ae_send_mode: ae_send_mode {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <20>;
            tap-ms = <20>;
            bindings = <&kp AE_CHORD>, <&kp Y>;
        };

        ae_send_empty: ae_send_empty {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <20>;
            tap-ms = <20>;
            bindings = <&kp AE_CHORD>, <&kp LS(Y)>;
        };

        ae_send_empty_follow: ae_send_empty_follow {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <20>;
            tap-ms = <20>;
            bindings = <&kp AE_CHORD>, <&kp LG(LS(Y))>;
        };

        // Leader Key sequences

        lk_aero_foc_mon: lk_aero_focus_monitor_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <100>;
            bindings = <&kp LEADERK &kp A &kp F>;
        };

        // Open Typora

        lk_open_typora: lk_open_typora_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <100>;
            bindings = <&kp LEADERK &kp O &kp N>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_lshift {
            timeout-ms = <50>;
            key-positions = <36 37>;   // S + D
            bindings = <&kp LSHFT>;
            layers = <BASE>;
        };

        combo_rshift {
            timeout-ms = <50>;
            key-positions = <42 43>;   // K + L
            bindings = <&kp RSHFT>;
            layers = <BASE>;
        };

        combo_caps_word {
            timeout-ms = <75>;
            require-prior-idle-ms = <125>;
            key-positions = <36 37 42 43>;   // S + D + K + L
            bindings = <&caps_word>;
            layers = <BASE>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        resize_combo {
            if-layers = <WIN_MOVE WIN_SWAP>;
            then-layer = <WIN_RESIZE>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // BASE 0

        base_layer {
            // ---------------------------------------------------------------------------------------------------------------------------------------
            // | ESC   |NONE |NONE |NONE | NONE |                                                                    | NONE |NONE |NONE | NONE | BOOT |
            // | NONE  |  1  |  2  |  3  |  4   |  5   |                                                    |  6   |  7   |  8  |  9  |  0   |  -   |
            // | NONE  |  Q  |  W  |  E  |  R   |  T   |                                                    |  Y   |  U   |  I  |  O  |  P   |  \   |
            // | NONE  |  A  |  S  |  D  |  F   |  G   |                                                    |  H   |  J   |  K  |  L  |  ;   |  '   |
            // | NONE  |  Z  |  X  |  C  |  V   |  B   | MO(WIN)| NONE  | NONE  | NONE  | NONE  | OSL(UNI)|  N   |  M   |  ,  |  .  |  /   | NONE |
            // | MAGIC |LCTL |LALT |LGUI |LSHFT |       | MO(SYM)| MO(NAV)| NONE | NONE  | ENT   | SYM/SPC|      | RSHFT| RGUI| RALT| RCTL | NONE |

            bindings = <
&kp ESC         &none      &none     &none     &none                                                                                &none      &none      &none     &none      &bootloader
&none           &kp N1     &kp N2    &kp N3    &kp N4     &kp N5                                                            &kp N6  &kp N7     &kp N8     &kp N9    &kp N0     &kp MINUS
&none           &kp Q      &kp W     &kp E     &kp R      &kp T                                                             &kp Y   &kp U      &kp I      &kp O     &kp P      &none
&caps_word      &kp A      &kp S     &kp D     &kp F      &kp G                                                             &kp H   &kp J      &kp K      &kp L     &kp SEMI   &kp SQT
&none           &kp Z      &kp X     &kp C     &kp V      &kp B   &mo WIN  &none    &none  &none  &none      &sl UNI        &kp N   &kp M      &kp COMMA  &kp DOT   &kp FSLH   &none
&magic MAGIC 0  &kp LCTRL  &kp LALT  &kp LGUI  &kp LSHFT          &mo SYM  &mo NAV  &none  &none  &kp ENTER  &lt SYM SPACE          &kp RSHFT  &kp RGUI   &kp RALT  &kp RCTRL  &none
            >;
        };

        // NUM 1

        num_layer {
            // NUM layer — numpad on right hand, entry key stays transparent

            bindings = <
&none   &none   &none   &none   &none                                                               &none   &none   &none    &none      &none
&none   &none   &none   &none   &none   &none                                                &none  &none   &none   &none    &none      &none
&none   &none   &none   &none   &none   &none                                                &none  &kp N7  &kp N8  &kp N9   &none      &none
&none   &none   &none   &none   &none   &none                                                &none  &kp N4  &kp N5  &kp N6   &kp MINUS  &none
&none   &none   &none   &none   &none   &trans  &trans  &none   &none  &none  &none  &none   &none  &kp N1  &kp N2  &kp N3   &kp FSLH   &none
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &none  &none  &none  &kp N0         &none   &none   &kp DOT  &none      &none
            >;
        };

        // MAGIC 2

        magic_layer {
            bindings = <
&bt BT_CLR   &none            &none            &none            &none                                                                                     &none  &none  &none  &none     &bt BT_CLR_ALL
&none        &none            &none            &none            &none            &none                                                             &none  &none  &none  &none  &none     &none
&none        &rgb_ug RGB_SPI  &rgb_ug RGB_SAI  &rgb_ug RGB_HUI  &rgb_ug RGB_BRI  &rgb_ug RGB_TOG                                                   &none  &none  &none  &none  &none     &none
&bootloader  &rgb_ug RGB_SPD  &rgb_ug RGB_SAD  &rgb_ug RGB_HUD  &rgb_ug RGB_BRD  &rgb_ug RGB_EFF                                                   &none  &none  &none  &none  &none     &bootloader
&sys_reset   &none            &none            &none            &none            &none            &bt_2  &bt_3  &none         &none  &none  &none  &none  &none  &none  &none  &none     &sys_reset
&none        &none            &none            &none            &none                             &bt_0  &bt_1  &out OUT_USB  &none  &none  &none         &none  &none  &none  &to GAME  &to TEST
            >;
        };

        // TEST 3

        factory_test_layer {
            bindings = <
&kp N0  &kp N6  &kp N2  &kp N8  &kp N4                                                                  &kp N4  &kp N8  &kp N2  &kp N6  &kp N0
&kp N1  &kp N7  &kp N3  &kp N9  &kp N5  &kp N0                                                  &kp N0  &kp N5  &kp N9  &kp N3  &kp N7  &kp N1
&kp N2  &kp N8  &kp N4  &kp N0  &kp N6  &kp N1                                                  &kp N1  &kp N6  &kp N0  &kp N4  &kp N8  &kp N2
&kp N3  &kp N9  &kp N5  &kp N1  &kp N7  &kp N2                                                  &kp N2  &kp N7  &kp N1  &kp N5  &kp N9  &kp N3
&kp N4  &kp N0  &kp N6  &kp N2  &kp N8  &kp N3  &kp N4  &kp N5  &kp N6  &kp N6  &kp N5  &kp N4  &kp N3  &kp N8  &kp N2  &kp N6  &kp N0  &kp N4
&kp N5  &kp N1  &kp N7  &kp N3  &kp N9          &kp N7  &kp N8  &kp N9  &kp N9  &kp N8  &kp N7          &kp N9  &kp N3  &kp N7  &kp N1  &kp N5
            >;
        };

        // NAV 4

        nav_layer {
            // NAV: HJKL arrows, home row mods on left, nav cluster on right bottom alpha

            bindings = <
&none   &none      &none     &none     &none                                                                          &none        &none        &none        &none        &none
&none   &none      &none     &none     &none      &none                                                     &none     &none        &none        &none        &none        &none
&none   &none      &none     &none     &none      &none                                                     &none     &kp HS_PTAB  &none        &kp HS_NTAB  &none        &none
&none   &kp LCTRL  &kp LALT  &kp LGUI  &kp LSHFT  &none                                                     &kp LEFT  &kp DOWN     &kp UP       &kp RIGHT    &none        &none
&none   &none      &none     &none     &none      &none  &none  &none   &none  &none  &none          &none  &kp HOME  &kp PG_DN    &kp PG_UP    &kp END      &none        &none
&trans  &none      &none     &none     &none             &none  &trans  &none  &none  &kp LS(ENTER)  &none            &kp HS_SCDN  &kp HS_SCUP  &kp HS_BTN1  &kp HS_MCTR  &none
            >;
        };

        // SYM 5

        sym_layer {
            // SYM: symbols on left alpha, parens/brackets on right, mods on left home row

            bindings = <
&none   &none      &none     &none        &none                                                                                  &none     &none      &none     &none             &none
&none   &none      &none     &none        &none      &none                                                            &kp CARET  &kp AMPS  &kp ASTRK  &none     &none             &none
&none   &kp EXCL   &kp AT    &kp HASH     &kp DLLR   &kp PRCNT                                                        &kp ESC    &kp LBRC  &kp TAB    &kp RBRC  &kp SINGLE_QUOTE  &none
&none   &kp LCTRL  &kp LALT  &kp LGUI     &kp LSHFT  &kp EQUAL                                                        &kp PIPE   &kp LPAR  &kp MINUS  &kp RPAR  &kp COLON         &kp DQT
&none   &kp BSLH   &kp LT    &td_cpy_pst  &kp GT     &lht 1 1   &none   &none  &none  &none  &kp DEL        &none     &kp GRAVE  &kp LBKT  &kp UNDER  &kp RBKT  &kp QMARK         &none
&trans  &trans     &trans    &trans       &trans                &trans  &none  &none  &none  &kp LG(ENTER)  &kp BSPC             &trans    &trans     &trans    &trans            &none
            >;
        };

        // UNI 6

        uni_layer {
            // UNI: app launchers via Hammerspoon, media, Magnet

            bindings = <
&none   &none      &none     &none        &none                                                                               &none        &none            &none        &none        &none
&none   &none      &none     &none        &none      &none                                                       &none        &none        &none            &none        &none        &none
&none   &none      &none     &kp HS_MENU  &none      &none                                                       &kp HS_CHRM  &kp HS_MEET  &lk_open_typora  &kp HS_SLAK  &kp HS_CODE  &kp HS_TERM
&none   &sk LCTRL  &sk LALT  &sk LGUI     &sk LSHFT  &none                                                       &td_rtm      &kp C_PREV   &kp C_PP         &kp C_NEXT   &kp HS_SPFY  &none

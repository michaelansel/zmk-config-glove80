if SHIELD_GLOVE80_DONGLE

# The macOS battery reader finds the dongle's serial port by looking this name up
# in the IORegistry (ioreg -n Glove80). Renaming it silently breaks that reader.
# See docs/battery-telemetry.md.
config ZMK_KEYBOARD_NAME
    default "Glove80"

config ZMK_SPLIT
    default y

config ZMK_SPLIT_BLE
    default y

config ZMK_SPLIT_ROLE_CENTRAL
    default y

config ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS
    default 2

config ZMK_SPLIT_BLE_CENTRAL_BATTERY_LEVEL_FETCHING
    default y

endif
